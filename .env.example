# ===========================================
# 数据库配置 (Neon PostgreSQL)
# ===========================================
# Neon 数据库连接字符串 (用于连接池)
DATABASE_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Neon 直连 URL (用于迁移)
DIRECT_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ===========================================
# Better Auth 配置
# ===========================================
# Better Auth 密钥 (生成方式: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-secret-key-here"

# Better Auth URL (生产环境替换为实际域名)
BETTER_AUTH_URL="http://localhost:3000"

# ===========================================
# Stripe 配置
# ===========================================
# Stripe 可发布密钥 (公开密钥，可在前端使用)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Stripe 密钥 (私密密钥，仅在服务端使用)
STRIPE_SECRET_KEY="sk_test_xxx"

# Stripe Webhook 密钥 (用于验证 Webhook 签名)
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ===========================================
# Resend 配置
# ===========================================
# Resend API 密钥 (用于发送邮件)
RESEND_API_KEY="re_xxx"

# 发件人邮箱地址
RESEND_FROM_EMAIL="noreply@yourdomain.com"
